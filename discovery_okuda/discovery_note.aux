\@writefile{toc}{\contentsline {paragraph}{An average cannot see a pattern.}{15}{paragraph*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The measurement that answers the campaign's own question was never taken.}{15}{paragraph*.2}\protected@file@percent }
